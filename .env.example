# Ordinary QQ account / NapCat route (no official QQ app credentials required).
# Relative paths are resolved from this project. Restart after changing this file.
BOT_RECORD_ROOT=./records
CODEX_MODEL=gpt-6.1-sol
CODEX_REASONING=high
# Optional absolute executable path; otherwise use the command available on PATH.
CODEX_BIN=codex
# Optional existing local HTTP proxy for Codex requests, e.g. http://127.0.0.1:7897.
CODEX_PROXY=
# Legacy official QQ bot route only (npm run start:official):
QQ_APP_ID=your_app_id
QQ_APP_SECRET=your_app_secret
QQ_API_BASE=https://api.bot.qq.com
QQ_TOKEN_URL=https://api.bot.qq.com/app/getAppAccessToken
PORT=8787
# Official group_openid values, not numeric QQ group numbers.
QQ_ALLOWED_GROUPS=
